meta {
  name: Crear persona
  type: http
  seq: 1
}

post {
  url: {{base_url}}/persons
  body: json
  auth: inherit
}

body:json {
  {
      "nombre": "Benjamin",
      "apellido": "Vargas",
      "email": "bvargas161@alumnos.iua.edu.ar",
      "extra": {
      "dni": "44078161",
      "area": "sistemas"
      }
  } 
}

script:post-response {
  // Verificar que la respuesta sea exitosa
  if (res.getStatus() === 201) {
    const data = res.getBody();
    
    // Guardar el token en la variable de entorno
    // Ajusta 'data.token' según la estructura exacta de tu JSON
    if (data && data.personId) {
      console.log(data.personId);
      bru.setEnvVar("current_personId", data.personId);
      console.log("Person ID actualizado.");
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
